---
import Reveal from "./Reveal.tsx";

const events = [
  {
    time: "7:30 AM",
    title: "Wake up",
    body: "First thing is a potty break (pee and poop), followed by a morning walk.",
    note: "If you took her out for a late potty break the night before, you can sleep in until 8:30–9:00 AM at the latest, then go straight to breakfast.",
  },
  {
    time: "8:00 – 9:00 AM",
    title: "Breakfast",
    note: "No play or walks for 30–45 minutes after — same rule as dinner, helps prevent bloating.",
  },
  {
    time: "9:00 AM – 1:00 PM",
    title: "Morning rest",
    body: "Long stretch of naps with a bit of play around 11:30 AM. Let her sleep — it keeps her even-tempered.",
    muted: true,
  },
  {
    time: "1:00 – 4:00 PM",
    title: "Afternoon naps",
    body: "More rest, with a potty break around 2:00 PM (pee and poop).",
    muted: true,
  },
  {
    time: "4:30 PM",
    title: "Longer walk + potty break",
    body: "Pee and maybe poop. Good time for a real outing.",
  },
  {
    time: "5:30 – 7:30 PM",
    title: "Dinner window",
    body: "Feed her any time in this window.",
    note: "No play or walks for at least 30–45 minutes after dinner.",
  },
  {
    time: "7:00 PM",
    title: "Evening nap",
    muted: true,
  },
  {
    time: "8:30 – 9:00 PM",
    title: "Active time",
    body: "She'll be playing and looking for some attention. Or she might just nap.",
  },
  {
    time: "10:00 PM",
    title: "Winding down",
    body: "Bedtime soon.",
    note: "She doesn't sleep in the bedroom. If you'd rather have her in the room, that's fine — just don't let her on the bed.",
  },
  {
    time: "10:30 – 11:00 PM",
    title: "Last potty break",
    body: "Quick pee right before you head to bed — optional but recommended.",
    note: "Doing this lets you sleep in until 8:30–9:00 AM the next morning.",
  },
];
---

<div class="relative">
  <div
    aria-hidden="true"
    class="absolute left-[8.5rem] sm:left-[10rem] top-2 bottom-2 w-px bg-ink/10"
  ></div>

  <ol class="space-y-7">
    {
      events.map((e, i) => (
        <Reveal client:visible delay={Math.min(i * 0.04, 0.4)}>
          <li class="relative flex gap-5 sm:gap-7 items-start">
            <div class="w-28 sm:w-32 flex-shrink-0 pt-1.5 text-right">
              <span
                class:list={[
                  "font-semibold text-sm sm:text-base tabular-nums",
                  e.muted ? "text-ink-soft" : "text-ink",
                ]}
              >
                {e.time}
              </span>
            </div>

            <span
              aria-hidden="true"
              class:list={[
                "relative flex-shrink-0 mt-2.5 w-3 h-3 rounded-full ring-4 ring-cream",
                e.muted ? "bg-ink/20" : "bg-tan",
              ]}
            />

            <div class="flex-1 min-w-0 pb-1">
              <h3
                class:list={[
                  "font-semibold leading-snug",
                  e.muted ? "text-ink-soft text-base" : "text-ink text-lg",
                ]}
              >
                {e.title}
              </h3>
              {e.body && (
                <p
                  class:list={[
                    "mt-1 leading-relaxed",
                    e.muted ? "text-ink-soft text-[15px]" : "text-ink-soft",
                  ]}
                >
                  {e.body}
                </p>
              )}
              {e.note && (
                <p class="mt-2.5 inline-block text-sm bg-tan/15 text-tan-deep px-3 py-1.5 rounded-lg border border-tan/25">
                  {e.note}
                </p>
              )}
            </div>
          </li>
        </Reveal>
      ))
    }
  </ol>
</div>

<Reveal client:visible>
  <div class="mt-14 rounded-2xl bg-cream-soft/70 border border-ink/5 p-6">
    <p class="text-xs font-bold tracking-[0.18em] uppercase text-tan-deep mb-2">
      One thing to remember
    </p>
    <p class="text-ink-soft leading-relaxed">
      She needs <strong class="text-ink">plenty of rest throughout the day</strong> —
      it's what keeps her even-tempered. If she seems overly excited or stimulated,
      she probably needs sleep. She's no longer a puppy, so she's pretty steady, but
      the naps are doing real work.
    </p>
  </div>
</Reveal>
