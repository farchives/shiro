---
import Reveal from "./Reveal.tsx";

interface Item {
  title: string;
  body: string;
  hint?: string;
}

interface Props {
  items: Item[];
  accent?: "tan" | "sky";
}

const { items, accent = "tan" } = Astro.props;
const accentClass =
  accent === "sky"
    ? "bg-sky/10 border-sky/30 text-sky-deep"
    : "bg-tan/15 border-tan/30 text-tan-deep";
---

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
  {
    items.map((item, i) => (
      <Reveal client:visible delay={i * 0.07}>
        <article class="h-full rounded-3xl bg-white p-7 shadow-soft border border-ink/5 hover:shadow-lift hover:-translate-y-1 transition-all duration-300">
          {item.hint && (
            <span class:list={["inline-block text-[11px] font-bold tracking-[0.15em] uppercase px-2.5 py-1 rounded-full border mb-4", accentClass]}>
              {item.hint}
            </span>
          )}
          <h3 class="font-semibold text-xl text-ink mb-2">{item.title}</h3>
          <p class="text-ink-soft leading-relaxed text-[15px]">{item.body}</p>
        </article>
      </Reveal>
    ))
  }
</div>
