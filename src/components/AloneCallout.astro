---
import Reveal from "./Reveal.tsx";
---

<Reveal client:visible>
  <div class="mb-8 inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-tan/15 border border-tan/30">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-tan-deep flex-shrink-0" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <polyline points="12 6 12 12 16 14" />
    </svg>
    <p class="text-ink leading-relaxed">
      <strong class="text-ink font-semibold">Maximum 6 hours alone.</strong>
      <span class="text-ink-soft"> Plan around this and she'll be fine.</span>
    </p>
  </div>
</Reveal>
