---
import Reveal from "./Reveal.tsx";

const contacts = [
  {
    role: "Regular Vet",
    name: "Emerald Animal Hospital",
    address: "4185 Ridge Rd, Cleveland, OH 44144",
    phone: "(216) 749-7161",
    phoneHref: "tel:+12167497161",
  },
  {
    role: "Emergencies · 24 hours",
    name: "MedVet Cleveland",
    address: "20400 Emerald Pkwy, Cleveland, OH 44135",
    phone: "(216) 362-6000",
    phoneHref: "tel:+12163626000",
    badge: "Open 24 hrs",
  },
];

const vitals = [
  {
    label: "Sex",
    value: "Female",
    detail: "Spayed",
  },
  {
    label: "Microchipped",
    value: "Yes",
    detail: "Chip ID: —",
  },
  {
    label: "Insured",
    value: "Yes",
    detail: "Provider: —",
  },
];
---

<Reveal client:visible>
  <div class="rounded-3xl bg-gradient-to-br from-coral/10 via-cream to-coral/5 border-2 border-coral/30 p-8 md:p-12 shadow-lift">
    <div class="flex items-start gap-4 mb-10">
      <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-coral text-cream flex items-center justify-center shadow-soft">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
        </svg>
      </div>
      <div>
        <p class="text-xs font-bold tracking-[0.2em] uppercase text-coral-deep mb-1">
          If something feels off
        </p>
        <h3 class="font-display text-5xl text-ink leading-none">
          Don't wait — call.
        </h3>
      </div>
    </div>

    <p class="text-xs font-bold tracking-[0.2em] uppercase text-ink-soft mb-4">
      Vets
    </p>
    <ul class="grid md:grid-cols-2 gap-5">
      {
        contacts.map((c) => (
          <li>
            <a
              href={c.phoneHref}
              class="block h-full rounded-2xl bg-white p-6 border border-ink/5 hover:border-coral/40 hover:shadow-soft transition-all duration-200"
            >
              <div class="flex items-center justify-between mb-3">
                <p class="text-xs font-bold tracking-[0.18em] uppercase text-ink-soft">
                  {c.role}
                </p>
                {c.badge && (
                  <span class="text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-coral/15 text-coral-deep">
                    {c.badge}
                  </span>
                )}
              </div>
              <h4 class="font-display text-3xl text-ink leading-tight">
                {c.name}
              </h4>
              <p class="text-ink-soft text-sm mt-2 leading-relaxed">
                {c.address}
              </p>
              <p class="mt-4 inline-flex items-center gap-2 text-coral-deep font-semibold">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {c.phone}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 pt-8 border-t border-coral/20">
      <p class="text-xs font-bold tracking-[0.2em] uppercase text-ink-soft mb-4">
        Her vitals
      </p>
      <ul class="grid sm:grid-cols-3 gap-4">
        {
          vitals.map((v) => (
            <li class="rounded-2xl bg-white p-5 border border-ink/5">
              <p class="text-xs font-semibold tracking-wider uppercase text-ink-soft">
                {v.label}
              </p>
              <p class="font-display text-2xl text-ink mt-1 leading-none">
                {v.value}
              </p>
              <p class="text-sm text-ink-soft mt-2">{v.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Reveal>
