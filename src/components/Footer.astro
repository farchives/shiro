      height="44"
      viewBox="0 0 24 24"
      class="mx-auto mb-5 text-tan"
      fill="currentColor"
    >
      <ellipse cx="6" cy="9" rx="2" ry="2.6" />
      <ellipse cx="18" cy="9" rx="2" ry="2.6" />
      <ellipse cx="9" cy="5" rx="1.7" ry="2.2" />
      <ellipse cx="15" cy="5" rx="1.7" ry="2.2" />
